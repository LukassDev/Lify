# Optional default for Web. Users can instead save a Client ID in Lify Settings.
# Android uses its registered package + SHA-1 and does not require this value.
# Public OAuth client IDs only. Never put a client secret in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: only required for iOS builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
